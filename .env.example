# ---- Database ----
# Local dev (SQLite). For production use Postgres (Supabase / Neon / Railway) - SQLite does not
# work on Vercel/Netlify because their filesystem is read-only/ephemeral.
DATABASE_URL="file:./dev.db"
# Postgres example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# ...and change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma

# ---- Auth (REQUIRED in production) ----
# Generate with: openssl rand -base64 48
JWT_SECRET=""

# ---- Payment gateway webhook (REQUIRED for /api/webhooks/payment) ----
# The signing secret configured in your Razorpay/Cashfree dashboard.
WEBHOOK_SECRET=""

# ---- Business rules ----
# Used for CGST/SGST vs IGST when the dealer GSTIN is not set. Otherwise derived from the GSTIN.
DEALER_STATE="Delhi"
# Credit given to newly registered shops (default 0). Raise per customer after verification.
NEW_ACCOUNT_CREDIT_LIMIT="0"

# ---- Seeding (prisma/seed.ts) ----
# Required when seeding: passwords for the initial accounts. Never commit real values.
SEED_DEALER_EMAIL="dealer@example.com"
SEED_DEALER_PHONE="9876500000"
SEED_DEALER_PASSWORD=""
# Demo accounts are only created when SEED_DEMO_USERS=true (never in production).
SEED_DEMO_USERS="false"

# Show one-click demo logins on the sign-in modal (local demos only, never production)
NEXT_PUBLIC_DEMO_MODE="false"
